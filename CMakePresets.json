{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "NUMCORE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/debug-build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NUMCORE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-native",
      "displayName": "Release (native)",
      "description": "P1 version 4: Release + -march=native (AVX2/FMA on this CPU). Binaries only run on CPUs with the same features.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-native",
      "cacheVariables": {
        "NUMCORE_NATIVE": "ON"
      }
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-native",
      "displayName": "Release (native)",
      "configurePreset": "release-native",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
